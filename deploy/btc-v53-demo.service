[Unit]
Description=v53 OKX official Demo execution
Wants=mihomo-proxy.service
After=mihomo-proxy.service

[Service]
Type=simple
WorkingDirectory=%h/btc-v53-demo
ExecStart=/usr/bin/python3 -u %h/btc-v53-demo/launch.py run
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
